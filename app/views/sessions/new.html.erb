<style>
  body {
    background: transparent !important;
  }
  .universe-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -10;
    background: radial-gradient(ellipse at bottom, #1b2735 0%, #090a0f 100%);
    overflow: hidden;
  }
  .universe-stars {
    position: absolute;
    width: 150%;
    height: 150%;
    background: transparent url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200"><circle cx="20" cy="50" r="1.5" fill="%23fff" opacity="0.8"/><circle cx="150" cy="130" r="2" fill="%23fff" opacity="0.6"/><circle cx="80" cy="180" r="1.2" fill="%23fff" opacity="0.9"/><circle cx="180" cy="30" r="1" fill="%23fff" opacity="0.5"/><circle cx="90" cy="90" r="2.5" fill="%23aaa" opacity="0.4"/></svg>') repeat top center;
    z-index: -9;
    animation: universe-move 100s linear infinite;
  }
  @keyframes universe-move {
    from { transform: translate(0, 0); }
    to { transform: translate(-10%, -10%); }
  }
  .universe-card {
    background: rgba(18, 22, 40, 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    color: #fff;
  }
  .universe-title {
    background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0px 5px 25px rgba(79, 172, 254, 0.5);
  }
  .universe-input {
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    color: #fff !important;
  }
  .universe-input:focus {
    background: rgba(255, 255, 255, 0.12) !important;
    border-color: #4facfe !important;
    box-shadow: 0 0 20px rgba(79, 172, 254, 0.4) !important;
  }
  .form-floating label {
    color: rgba(255, 255, 255, 0.6);
  }
  .form-floating > .form-control:focus ~ label,
  .form-floating > .form-control:not(:placeholder-shown) ~ label {
    color: rgba(255, 255, 255, 0.9);
  }
  /* Fix autocomplete styles for webkit */
  .form-floating > .form-control:-webkit-autofill {
    -webkit-box-shadow: 0 0 0 30px #1a233a inset !important;
    -webkit-text-fill-color: #fff !important;
  }
  .universe-btn {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    border: none;
    font-weight: 700;
    color: #0b1328;
    transition: all 0.3s ease;
  }
  .universe-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(79, 172, 254, 0.6);
    color: #0b1328;
  }
  .universe-text-muted {
    color: #a1b0cc !important;
  }
  .universe-link {
    color: #4facfe;
    transition: all 0.3s ease;
  }
  .universe-link:hover {
    color: #00f2fe;
    text-shadow: 0 0 10px rgba(0, 242, 254, 0.8);
  }
</style>

<div class="universe-bg">
  <div class="universe-stars"></div>
</div>

<div class="row flex-grow-1 justify-content-center align-items-center mt-5">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="card login-card universe-card border-0">
      <div class="card-body p-5">
        <div class="text-center mb-4">
          <h1 class="h3 mb-3 fw-bold universe-title">Welcome Back</h1>
          <p class="universe-text-muted mb-0">Sign in to your account</p>
        </div>

        <%= form_with url: session_path, class: "needs-validation" do |form| %>
          <div class="form-floating mb-3">
            <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", placeholder: "name@example.com", value: params[:email], class: "form-control universe-input" %>
            <%= form.label :email, "Email address" %>
          </div>

          <div class="form-floating mb-4">
            <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Password", maxlength: 72, class: "form-control universe-input" %>
            <%= form.label :password, "Password" %>
          </div>

          <div class="d-grid">
            <%= form.submit "Sign in", class: "btn btn-lg rounded-3 universe-btn" %>
          </div>
        <% end %>

        <div class="text-center mt-4">
          <%= link_to "Forgot password?", new_password_path, class: "text-decoration-none fw-medium universe-link" %>
        </div>
      </div>
    </div>
  </div>
</div>
