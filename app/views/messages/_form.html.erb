<%= turbo_frame_tag "new_message", target: "_top" do %>
  <%= form_with(model: [room, message], id: "new_message_form", class: "chat-input-container") do |form| %>
    <%= form.text_field :content, placeholder: "Type a message...", class: "chat-textarea", autocomplete: "off", required: true %>
    <button type="submit" class="chat-send-btn">
      <i class="bi bi-send-fill fs-5"></i>
    </button>
  <% end %>
<% end %>
