#!/bin/bash -e
set -e

# Remove a potentially pre-existing server.pid for Rails.
if [ -f tmp/pids/server.pid ]; then
  rm -f tmp/pids/server.pid
fi

# 1. Export all environment variables so BusyBox crond can access them
printenv | grep -E '^(RAILS_|BUNDLE_|DATABASE_|REDIS_|SECRET_|GMAIL_|PATH)' | sed 's/^\(.*\)$/export \1/g' > /rails/.env.cron

# 2. Update crontab via whenever and start Alpine crond in background
bundle exec whenever --update-crontab
crond -b -l 8

# Prepare the database (create + migrate, idempotent)
if [ "$RAILS_ENV" = "production" ] || [ "$RAILS_ENV" = "staging" ]; then
  echo "Running database preparation..."
  bundle exec rails db:prepare
fi

# Then exec the container's main process (whatever is passed as CMD)
exec "$@"
